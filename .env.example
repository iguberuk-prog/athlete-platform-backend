# Copy to .env for local Supabase testing, or set these in the Netlify dashboard.
# Local development defaults to SQLite and needs none of these.

# Choose the database backend: "sqlite" (default, local) or "supabase" (production)
DB_BACKEND=supabase

# From Supabase: Project Settings -> Data API / API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# IMPORTANT: the SERVICE ROLE key (server-side secret). Never expose to a browser.
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: where the local SQLite file lives (sqlite backend only)
# SQLITE_PATH=data/athlete.db
