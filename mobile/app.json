{
  "expo": {
    "name": "Athlete Performance",
    "slug": "athlete-performance",
    "scheme": "athleteperformance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0e12",
    "ios": {
      "bundleIdentifier": "com.guberuk.athleteperformance",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scan food barcodes and take photos of meals to check them against your food rules.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of a meal to check it against your food rules.",
        "UIBackgroundModes": []
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.guberuk.athleteperformance"
        ]
      }
    },
    "android": {
      "package": "com.guberuk.athleteperformance",
      "adaptiveIcon": {
        "backgroundColor": "#0b0e12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0b0e12"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#bff63f"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Athlete Performance reads last night's sleep, resting heart rate and heart-rate variability to fill in your daily check-in. It never writes to Health or shares this data.",
          "NSHealthUpdateUsageDescription": "Athlete Performance does not write to Apple Health.",
          "background": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "appUrl": "https://peaceful-paletas-0a1cb4.netlify.app"
    }
  }
}
